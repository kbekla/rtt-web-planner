# Local AI helper runtime (optional). Localhost only, one model, GPU-first.
# Installed by scripts/install-units (@FACTORY_DIR@ is substituted).
[Unit]
Description=RT&T factory local AI helper (Ollama, localhost only)
After=network.target

[Service]
Type=simple
ExecStart=@FACTORY_DIR@/tools/ollama/bin/ollama serve
Environment=OLLAMA_HOST=127.0.0.1:11434
Environment=OLLAMA_MODELS=@FACTORY_DIR@/ai/models
Environment=OLLAMA_NUM_PARALLEL=1
Environment=OLLAMA_MAX_LOADED_MODELS=1
Environment=OLLAMA_KEEP_ALIVE=5m
Environment=OLLAMA_CONTEXT_LENGTH=4096
Environment=OLLAMA_FLASH_ATTENTION=1
Environment=OLLAMA_KV_CACHE_TYPE=q8_0
Environment=OLLAMA_NOPRUNE=1
Environment=OLLAMA_NO_CLOUD=1
Environment=CUDA_VISIBLE_DEVICES=0
# Never compete with Planetiler for CPU, IO or RAM. If a model spills out of VRAM
# into system RAM, the cgroup cap stops it from growing; the helper then falls
# back to rules-only mode.
Nice=10
CPUWeight=20
IOWeight=20
MemoryHigh=1536M
MemoryMax=2560M
MemorySwapMax=0
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
