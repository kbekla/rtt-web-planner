#!/usr/bin/env bash
# Block map data and large files from entering the repo.
# Enabled by `make setup` (git config core.hooksPath .githooks).
set -euo pipefail
MAX_BYTES=$((5 * 1024 * 1024))
fail=0
while IFS= read -r -d '' f; do
  case "$f" in
    *.pbf|*.osm|*.pmtiles|*.mbtiles|*.zip|*.tar.gz)
      echo "pre-commit: refusing map/archive file: $f" >&2; fail=1; continue ;;
  esac
  size=$(git cat-file -s ":$f" 2>/dev/null || echo 0)
  if (( size > MAX_BYTES )); then
    echo "pre-commit: refusing file over 5 MB: $f ($size bytes)" >&2; fail=1
  fi
done < <(git diff --cached --name-only --diff-filter=ACMR -z)
exit $fail
